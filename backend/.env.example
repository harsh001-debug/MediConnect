# MongoDB Atlas driver connection string, starting with mongodb+srv://
MONGODB_URI=
MONGODB_DB_NAME=mediconnect
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Account verification and password recovery
OTP_SECRET=
OTP_EMAIL_PROVIDER=smtp
OTP_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
NOTIFICATION_EMAIL_ENABLED=0

# Razorpay Test Mode checkout and refunds
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional prescription uploads and transcription
PRESCRIPTIONS_ENABLED=0
PRESCRIPTION_TEST_MODE=0
PRESCRIPTION_DOCTOR_IDS=
PRESCRIPTION_RETENTION_DAYS=
PRESCRIPTION_AUDIT_RETENTION_DAYS=
PRESCRIPTION_GOOGLE_PROJECT=
PRESCRIPTION_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local seed accounts. Set passwords before running a seed script.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Project Admin
SEED_PATIENT_EMAIL=patient@example.com
SEED_PATIENT_PASSWORD=
SEED_PATIENT_NAME=Demo Patient
SEED_DEMO_DATA=0
SEED_DOCTOR_PASSWORD=
WB_DEMO_PASSWORD=
